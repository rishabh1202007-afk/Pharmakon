    "jsdom": "^31.0.1",
    "postcss": "^8.5.8",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
