    "test:coverage": "vitest --coverage",
    "deploy:gcp": "node scripts/deploy-gcp.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "animejs": "^4.3.6",
    "axios": "^1.14.0",
