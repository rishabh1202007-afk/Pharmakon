  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm:server\" \"npm:dev\"",
    "dev:next": "cd next_frontend && npm run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
